---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime, formatDate } from '@/data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Blog - Yasin Hassim"
  description="Read my thoughts on technology, development, and random things."
>
  <section class="shell pt-14 sm:pt-20">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow rise">Blog · {posts.length} posts</p>
      <h1 class="display rise mt-5 text-6xl sm:text-8xl text-primary" style="--i:1">
        Notes &amp; <em class="text-accent">write-ups</em>
      </h1>
      <p class="rise mt-6 text-lg text-secondary" style="--i:2">
        Writing about technology, development, and random things.
      </p>

      {allTags.length > 0 && (
        <div class="rise mt-10 flex flex-wrap gap-1.5" style="--i:3" role="group" aria-label="Filter by tag">
          <button type="button" class="chip" data-tag="" aria-pressed="true">All</button>
          {allTags.map((tag) => (
            <button type="button" class="chip" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      )}

      {posts.length > 0 ? (
        <ol class="mt-8 border-t rule" id="post-list">
          {posts.map((post, i) => (
            <li class="rise border-b rule" style={`--i:${Math.min(i, 8) + 3}`} data-tags={post.data.tags.join('|')}>
              <a href={`/blog/${post.slug}`} class="group block py-7">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>·</span>
                  <span>{readingTime(post.body)}</span>
                  {post.data.tags[0] && (<><span>·</span><span>{post.data.tags[0]}</span></>)}
                </div>
                <h2 class="display mt-3 text-3xl sm:text-4xl text-primary transition-colors group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-secondary">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-16 text-secondary">No posts yet. Check back soon.</p>
      )}
      <p id="no-match" class="hidden py-10 text-secondary">No posts with that tag.</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Tag filter: hide posts that don't carry the chosen tag
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const items = document.querySelectorAll<HTMLLIElement>('#post-list > li');
  const noMatch = document.getElementById('no-match');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let shown = 0;
      items.forEach((item) => {
        const match = !tag || (item.dataset.tags ?? '').split('|').includes(tag);
        item.hidden = !match;
        if (match) shown++;
      });
      noMatch?.classList.toggle('hidden', shown > 0);
    });
  });
</script>
