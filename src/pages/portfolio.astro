---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile, stats, projects, responsibilities, skillGroups, story } from '../data/profile';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const videos = projects.flatMap((p) => (p.video ? [p.video] : []));
---

<BaseLayout
  title="Work - Yasin Hassim"
  description="Projects, skills and story of Muhammad Yasin Abdul Hassim, a Software Developer, IT Technician and System Analyst in Kota Kinabalu, Sabah."
>
  <!-- Header -->
  <section id="home" class="shell pt-14 sm:pt-20 scroll-mt-20">
    <p class="eyebrow rise">Work · {profile.location}</p>
    <h1 class="display rise mt-5 max-w-4xl text-5xl sm:text-7xl text-primary" style="--i:1">
      Systems for government, landlords and <em class="text-accent">whoever's next.</em>
    </h1>
    <div class="rise mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end" style="--i:2">
      <p class="max-w-xl text-lg text-secondary">{profile.summary}</p>
      <dl class="flex gap-8">
        {stats.map((s) => (
          <div>
            <dd class="display text-4xl text-primary">{s.value}</dd>
            <dt class="mt-1 text-xs text-muted">{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Projects -->
  <section id="work" class="shell mt-20 scroll-mt-20">
    <div class="flex items-end justify-between border-b rule pb-4">
      <h2 class="display text-4xl text-primary">Selected projects</h2>
      <span class="font-mono text-xs text-muted">{projects.length} projects</span>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {featured.map((p, i) => (
        <article class="tile tile-hover rise flex flex-col gap-6 sm:p-8" style={`--i:${i}`}>
          <div class="flex items-start justify-between gap-4">
            <p class="eyebrow">{p.kind}</p>
            <span class="font-mono text-xs text-muted">0{i + 1}</span>
          </div>
          <div class="flex-1">
            <h3 class="display text-4xl sm:text-5xl text-primary">{p.name}</h3>
            <p class="mt-4 text-secondary">{p.description}</p>
            {p.note && <p class="mt-3 text-sm text-muted">{p.note}</p>}
          </div>
          <div class="flex flex-wrap gap-1.5">
            {p.tech.map((t) => <span class="chip">{t}</span>)}
          </div>
          <div class="flex flex-wrap gap-2 border-t rule pt-5">
            <a href={p.href} target="_blank" rel="noopener" class="btn-solid">
              <span class="status-dot"></span> {p.linkLabel}
            </a>
            {p.video && (
              <button type="button" class="btn-ghost" data-video-open={p.video.id}>
                <Icon name="play" class="w-4 h-4" /> {p.video.label}
              </button>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((p) => (
        <a href={p.href} target="_blank" rel="noopener" class="tile flex flex-col gap-5">
          <Icon name="external" class="tile-arrow w-4 h-4" />
          <p class="eyebrow pr-6">{p.kind}</p>
          <div class="flex-1">
            <h3 class="display text-3xl text-primary">{p.name}</h3>
            <p class="mt-2 text-sm text-secondary">{p.description}</p>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5">
              {p.tech.map((t) => <span class="chip">{t}</span>)}
            </div>
            <span class="text-xs text-muted">{p.linkLabel}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Day to day -->
  <section class="shell mt-24">
    <div class="grid gap-8 lg:grid-cols-[18rem_1fr]">
      <div>
        <p class="eyebrow">Responsibilities</p>
        <h2 class="display mt-3 text-4xl text-primary">What I do day to day</h2>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-[1.25rem] border rule sm:grid-cols-2 lg:grid-cols-3" style="background: var(--border-color);">
        {responsibilities.map((r, i) => (
          <li class="bg-secondary p-5 sm:p-6">
            <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-6 font-medium text-primary">{r.title}</p>
            <p class="mt-1 text-sm text-muted">{r.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="shell mt-24 scroll-mt-20">
    <div class="grid gap-8 lg:grid-cols-[18rem_1fr]">
      <div>
        <p class="eyebrow">Expertise</p>
        <h2 class="display mt-3 text-4xl text-primary">Tools and skills</h2>
      </div>
      <dl class="divide-y divide-rule border-y rule">
        {skillGroups.map((g) => (
          <div class="grid gap-3 py-5 sm:grid-cols-[9rem_1fr] sm:items-baseline">
            <dt class="text-sm font-medium text-primary">{g.name}</dt>
            <dd class="flex flex-wrap gap-1.5">
              {g.items.map((item) => <span class="rounded-full border rule px-3 py-1 text-sm text-secondary">{item}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Story -->
  <section id="about" class="shell mt-24 scroll-mt-20">
    <div class="grid gap-8 lg:grid-cols-[18rem_1fr]">
      <div>
        <p class="eyebrow">Journey</p>
        <h2 class="display mt-3 text-4xl text-primary">How I got here</h2>
        <p class="mt-4 text-sm text-secondary">{story.length} chapters, from a military camp in Kedah to writing software for a living.</p>
      </div>
      <div class="border-t rule">
        {story.map((chapter, i) => (
          <details class="chapter group border-b rule" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center gap-4 py-5">
              <span class="font-mono text-xs text-muted w-6">{String(i + 1).padStart(2, '0')}</span>
              {chapter.image ? (
                <img src={chapter.image} alt="" class="h-12 w-12 flex-shrink-0 rounded-xl object-cover transition-opacity group-open:opacity-0 sm:h-14 sm:w-14" loading="lazy" />
              ) : (
                <span class="chapter-badge h-12 w-12 flex-shrink-0 rounded-xl transition-opacity group-open:opacity-0 sm:h-14 sm:w-14" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              )}
              <div class="flex-1">
                <h3 class="display text-2xl sm:text-3xl text-primary">{chapter.title}</h3>
                <p class="mt-0.5 text-xs text-muted">{chapter.meta}</p>
              </div>
              <span class="icon-btn flex-shrink-0 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <div class="chapter-body grid gap-6 pb-8 sm:grid-cols-[14rem_1fr] sm:pl-10">
              {chapter.image ? (
                <img src={chapter.image} alt={chapter.title} class="aspect-[4/3] w-full rounded-xl object-cover sm:aspect-square" loading="lazy" />
              ) : (
                <span class="chapter-badge display aspect-[4/3] w-full rounded-xl text-7xl sm:aspect-square" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              )}
              <div class="space-y-4 leading-relaxed text-secondary">
                {chapter.body.map((para) => <p>{para}</p>)}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="shell mt-24 scroll-mt-20">
    <div class="tile overflow-hidden sm:p-10">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full opacity-60 blur-3xl" style="background: var(--accent-soft);"></div>
      <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="display mt-3 text-5xl sm:text-6xl text-primary">Ready to collaborate?</h2>
          <p class="mt-4 max-w-lg text-secondary">
            Whether you have a question, a project idea, or just want to say hi, feel free to reach out.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={`${profile.whatsapp}?text=${encodeURIComponent('Hi there! I just saw your portfolio.')}`} target="_blank" rel="noopener" class="btn-solid"><Icon name="whatsapp" class="w-4 h-4" /> WhatsApp</a>
          <a href={`mailto:${profile.email}`} class="btn-ghost"><Icon name="mail" class="w-4 h-4" /> Email</a>
          <a href={profile.github} target="_blank" rel="noopener" class="btn-ghost"><Icon name="github" class="w-4 h-4" /> GitHub</a>
          <a href={profile.resume} download={profile.resumeName} class="btn-ghost"><Icon name="download" class="w-4 h-4" /> Resume</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Walkthrough video modals. The YouTube player (privacy-enhanced domain) is only injected when
       a modal opens and removed when it closes, so nothing loads from YouTube until a visitor asks. -->
  {videos.map((v) => (
    <dialog id={v.id} class="video-dialog" data-youtube-id={v.youtubeId} aria-label={v.title}>
      <div class="p-3 sm:p-4">
        <div class="mb-3 flex items-center justify-between gap-4">
          <p class="text-sm font-medium text-primary">{v.title}</p>
          <button type="button" class="icon-btn" data-video-close aria-label="Close video"><Icon name="close" class="w-4 h-4" /></button>
        </div>
        <div class="video-frame" data-video-frame></div>
      </div>
    </dialog>
  ))}
</BaseLayout>

<style>
  .chapter summary::-webkit-details-marker { display: none; }
  .chapter[open] .chapter-body { animation: rise 0.45s ease-out both; }
  /* Stand-in for a chapter without a photo */
  .chapter-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--accent-primary);
    background: var(--accent-soft);
  }
  .chapter-badge.display { font-family: 'Instrument Serif', Georgia, serif; font-size: 4.5rem; }

  .video-dialog {
    width: min(1100px, calc(100vw - 32px));
    max-width: none;
    padding: 0;
    border: 1px solid var(--border-color);
    border-radius: 1.25rem;
    background: var(--bg-primary);
    color: var(--text-primary);
  }
  .video-dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(4px);
  }
  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }
  /* :global because the iframe is created by the script, outside Astro's scoped-style attributes */
  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Open a video dialog from any [data-video-open] button; load the player on open, unload on close.
  document.querySelectorAll<HTMLButtonElement>('[data-video-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.videoOpen ?? '') as HTMLDialogElement | null;
    if (!dialog) return;
    const frame = dialog.querySelector<HTMLElement>('[data-video-frame]');
    const id = dialog.dataset.youtubeId;
    button.addEventListener('click', () => {
      if (frame && id) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = dialog.getAttribute('aria-label') ?? 'Video';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        frame.replaceChildren(iframe);
      }
      dialog.showModal();
    });
    dialog.querySelector('[data-video-close]')?.addEventListener('click', () => dialog.close());
    // a click on the backdrop lands on the dialog element itself
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => frame?.replaceChildren());
  });
</script>
