---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { profile, stats, projects, coreStack, readingTime, formatDate } from '../data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [latest, ...olderPosts] = posts;
const recent = olderPosts.slice(0, 4);
const featured = projects.find((p) => p.featured) ?? projects[0];
---

<BaseLayout
  title="Yasin Hassim - IT Technician | Software Developer"
  description="Portfolio of Muhammad Yasin Abdul Hassim, an IT Technician and Software Developer specializing in Laravel, React, and full-stack development."
>
  <section class="shell pt-8 sm:pt-12">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 sm:gap-4">
      <!-- Intro -->
      <div class="tile rise flex flex-col justify-between gap-10 sm:col-span-2 lg:row-span-2 sm:p-8" style="--i:0">
        <div>
          <p class="eyebrow flex items-center gap-2">
            <Icon name="pin" class="w-3.5 h-3.5" /> {profile.location}
          </p>
          <h1 class="display mt-6 text-[3.25rem] sm:text-7xl text-primary">
            Hi, I'm Yasin.<br />
            <em class="text-accent">I build stuff.</em>
          </h1>
          <p class="mt-6 max-w-md text-secondary">
            {profile.role} and {profile.roleAlt.toLowerCase()}. Welcome to my personal corner of the internet.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/portfolio" class="btn-solid">See my work <Icon name="arrow" class="w-4 h-4" /></a>
          <a href={profile.resume} download={profile.resumeName} class="btn-ghost"><Icon name="download" class="w-4 h-4" /> Resume</a>
        </div>
      </div>

      <!-- Photo -->
      <div class="tile rise overflow-hidden p-0 sm:p-0 min-h-[18rem] lg:row-span-2" style="--i:1">
        <img src={profile.photo} alt={profile.fullName} class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 p-4" style="background: linear-gradient(transparent, rgb(0 0 0 / 0.65));">
          <p class="text-sm font-medium text-white">{profile.fullName}</p>
          <p class="font-mono text-[0.7rem] text-white/70">{profile.role} · {profile.roleAlt}</p>
        </div>
      </div>

      <!-- Status -->
      <a href={`mailto:${profile.email}`} class="tile rise flex flex-col justify-between gap-6" style="--i:2">
        <Icon name="arrow" class="tile-arrow w-4 h-4 -rotate-45" />
        <p class="eyebrow">Status</p>
        <div>
          <p class="flex items-center gap-2.5 text-lg font-medium text-primary">
            <span class="status-dot"></span> {profile.status}
          </p>
          <p class="mt-1 text-sm text-muted">Email me about a role or project.</p>
        </div>
      </a>

      <!-- Stats -->
      <div class="tile rise" style="--i:3">
        <p class="eyebrow">By the numbers</p>
        <dl class="mt-4 grid grid-cols-3 gap-2">
          {stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="display text-4xl text-primary">{s.value}</dd>
              <dd class="mt-1 text-xs leading-snug text-muted">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Latest post -->
      {latest && (
        <a href={`/blog/${latest.slug}`} class="tile rise flex flex-col justify-between gap-8 sm:col-span-2" style="--i:4">
          <Icon name="arrow" class="tile-arrow w-4 h-4 -rotate-45" />
          <p class="eyebrow">Latest post</p>
          <div>
            <h2 class="display text-3xl sm:text-4xl text-primary pr-6">{latest.data.title}</h2>
            <p class="mt-3 line-clamp-2 text-sm text-secondary">{latest.data.description}</p>
            <p class="mt-4 font-mono text-[0.7rem] text-muted">
              {formatDate(latest.data.pubDate)} · {readingTime(latest.body)}
            </p>
          </div>
        </a>
      )}

      <!-- Featured project -->
      <a href={featured.href} target="_blank" rel="noopener" class="tile rise flex flex-col justify-between gap-8 sm:col-span-2" style="--i:5">
        <Icon name="external" class="tile-arrow w-4 h-4" />
        <p class="eyebrow">Featured project</p>
        <div>
          <h2 class="display text-3xl sm:text-4xl text-primary">{featured.name}</h2>
          <p class="mt-3 line-clamp-2 text-sm text-secondary">{featured.description}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {featured.tech.map((t) => <span class="chip">{t}</span>)}
          </div>
        </div>
      </a>

      <!-- Stack -->
      <div class="tile rise flex flex-col justify-between gap-6 overflow-hidden sm:col-span-2 lg:col-span-3" style="--i:6">
        <div class="flex items-center justify-between">
          <p class="eyebrow">Daily stack</p>
          <a href="/portfolio#skills" class="text-xs text-muted hover:text-primary">All skills →</a>
        </div>
        <p class="display text-3xl sm:text-4xl text-primary">Tools I reach for</p>
        <div class="marquee overflow-hidden" aria-label={coreStack.join(', ')}>
          <div class="marquee-track" aria-hidden="true">
            {[...coreStack, ...coreStack].map((t) => (
              <span class="whitespace-nowrap rounded-full border rule px-4 py-2 text-sm text-secondary">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Elsewhere -->
      <div class="tile rise sm:col-span-2 lg:col-span-1" style="--i:7">
        <p class="eyebrow">Elsewhere</p>
        <ul class="mt-3 divide-y divide-rule text-sm">
          <li><a href={profile.github} target="_blank" rel="noopener" class="flex items-center justify-between py-2.5 text-primary hover:text-accent"><span class="flex items-center gap-2.5"><Icon name="github" class="w-4 h-4" /> GitHub</span><Icon name="external" class="w-3.5 h-3.5 text-muted" /></a></li>
          <li><a href={profile.whatsapp} target="_blank" rel="noopener" class="flex items-center justify-between py-2.5 text-primary hover:text-accent"><span class="flex items-center gap-2.5"><Icon name="whatsapp" class="w-4 h-4" /> WhatsApp</span><Icon name="external" class="w-3.5 h-3.5 text-muted" /></a></li>
          <li><a href={`mailto:${profile.email}`} class="flex items-center justify-between py-2.5 text-primary hover:text-accent"><span class="flex items-center gap-2.5"><Icon name="mail" class="w-4 h-4" /> Email</span><Icon name="external" class="w-3.5 h-3.5 text-muted" /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Writing -->
  {recent.length > 0 && (
    <section class="shell mt-24">
      <div class="flex items-end justify-between gap-4 border-b rule pb-4">
        <h2 class="display text-4xl sm:text-5xl text-primary">More writing</h2>
        <a href="/blog" class="text-sm text-secondary hover:text-primary whitespace-nowrap">All posts →</a>
      </div>
      <ol>
        {recent.map((post) => (
          <li class="border-b rule">
            <a href={`/blog/${post.slug}`} class="group grid gap-1 py-6 sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-6">
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-muted">{formatDate(post.data.pubDate)}</time>
              <div>
                <h3 class="text-lg font-medium text-primary group-hover:text-accent transition-colors">{post.data.title}</h3>
                <p class="mt-1 line-clamp-1 text-sm text-secondary">{post.data.description}</p>
              </div>
              <span class="hidden sm:inline font-mono text-xs text-muted">{readingTime(post.body)}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
