---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import Footer from '@components/Footer.astro';
import Icon from '@components/Icon.astro';
import SkinPicker from '@components/SkinPicker.astro';
import { skinRoutes, skinThemes } from '@/data/skins';

interface Props {
  title: string;
  description: string;
  image?: string;
  // Skin variants of a page point search engines at the default version
  canonical?: string;
  noindex?: boolean;
  // Set on a skin's own pages so a direct visit switches to that skin
  pageSkin?: string;
}

const { title, description, image = '/og-default.png', canonical, noindex = false, pageSkin } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(canonical ?? currentPath, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const links = [
  { href: '/', label: 'Home' },
  { href: '/portfolio', label: 'Work' },
  { href: '/blog', label: 'Blog' },
];

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en" data-page-skin={pageSkin}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Before first paint: pick the skin (a ?skin= link wins, then the saved choice), send
         home and work visits to that skin's version, then set the theme (forced by the skin,
         else the saved choice, else the system setting). -->
    <script is:inline define:vars={{ skinRoutes, skinThemes }}>
      var html = document.documentElement;
      var store = {
        get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
        set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
      };
      var fromUrl = new URLSearchParams(location.search).get('skin');
      if (fromUrl) store.set('skin', fromUrl);
      var skin = fromUrl || store.get('skin') || 'bento';
      // A skin's own pages (like /terminal/) mark themselves, so visiting one directly switches to it
      var pageSkin = html.getAttribute('data-page-skin');
      if (pageSkin && !fromUrl) { skin = pageSkin; store.set('skin', skin); }
      var path = location.pathname.replace(/\/$/, '') || '/';
      var target = skinRoutes[skin] && skinRoutes[skin][path];
      if (target && !pageSkin) location.replace(target);
      html.setAttribute('data-skin', skin);
      var theme = skinThemes[skin] || store.get('theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      html.setAttribute('data-theme', theme);
    </script>
  </head>
  <body id="top" class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b rule backdrop-blur-xl" style="background: color-mix(in srgb, var(--bg-primary) 82%, transparent);">
      <div class="shell flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-baseline gap-2 text-primary" aria-label="Yasin Hassim, home">
          <span class="display text-2xl">Yasin Hassim</span>
          <span class="hidden sm:inline font-mono text-[0.7rem] text-muted">/ dev</span>
        </a>

        <nav class="hidden md:flex items-center gap-1" aria-label="Main">
          {links.map((link) => (
            <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <SkinPicker />
          <button id="theme-toggle" class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode">
            <span class="theme-icon-dark"><Icon name="moon" class="w-4 h-4" /></span>
            <span class="theme-icon-light"><Icon name="sun" class="w-4 h-4" /></span>
          </button>
          <button id="menu-btn" class="icon-btn md:hidden" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <Icon name="menu" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="hidden md:hidden border-t rule" aria-label="Mobile">
        <div class="shell flex flex-col py-3">
          {links.map((link) => (
            <a href={link.href} class:list={['py-2.5 text-lg', isActive(link.href) ? 'text-primary' : 'text-secondary']}>
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <style>
      .theme-icon-light { display: none; }
      /* Skins with a fixed look don't offer light/dark */
      :global([data-skin='terminal']) .theme-toggle { display: none; }
      :global([data-theme='dark']) .theme-icon-light { display: inline; }
      :global([data-theme='dark']) .theme-icon-dark { display: none; }
    </style>

    <script>
      const html = document.documentElement;

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
      });

      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        const open = mobileMenu?.classList.toggle('hidden') === false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    </script>
  </body>
</html>
