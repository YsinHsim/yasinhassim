---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const currentYear = new Date().getFullYear();
---

<footer id="footer" class="mt-24 border-t rule">
  <div class="shell py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow mb-3">Say hello</p>
        <a href={`mailto:${profile.email}`} class="display text-3xl sm:text-5xl text-primary link-underline break-all sm:break-normal">
          {profile.email}
        </a>
      </div>

      <div class="flex items-center gap-2">
        <a href={profile.github} target="_blank" rel="noopener" class="icon-btn" aria-label="GitHub"><Icon name="github" class="w-4 h-4" /></a>
        <a href={profile.whatsapp} target="_blank" rel="noopener" class="icon-btn" aria-label="WhatsApp"><Icon name="whatsapp" class="w-4 h-4" /></a>
        <a href={`mailto:${profile.email}`} class="icon-btn" aria-label="Email"><Icon name="mail" class="w-4 h-4" /></a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} {profile.fullName}</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
        <a href="/" class="hover:text-primary">Home</a>
        <a href="/portfolio" class="hover:text-primary">Work</a>
        <a href="/blog" class="hover:text-primary">Blog</a>
        <a href={profile.resume} download={profile.resumeName} class="hover:text-primary">Resume</a>
      </nav>
      <p class="font-mono">Built with Astro &amp; Tailwind · {profile.location}</p>
    </div>
  </div>
</footer>
